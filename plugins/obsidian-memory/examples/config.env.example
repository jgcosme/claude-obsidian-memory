# obsidian-memory plugin configuration
# Copy to ~/.config/claude-memory/config.env and edit.
# All variables are optional; sensible defaults are used if unset.

# Path to your Obsidian vault (absolute path).
# Default: $HOME/Documents/Obsidian Vault
# export OBSIDIAN_VAULT_PATH="$HOME/Documents/Obsidian Vault"

# Path to the Obsidian CLI binary.
# Auto-detected if unset:
#   macOS: /Applications/Obsidian.app/Contents/MacOS/obsidian
#   Linux: whatever's on $PATH as `obsidian`
# export OBSIDIAN_CLI="/Applications/Obsidian.app/Contents/MacOS/obsidian"

# Where the SessionEnd review writes its log.
# Default: /tmp/claude-memory-review.log
# export MEMORY_REVIEW_LOG="/tmp/claude-memory-review.log"

# Path to the `claude` CLI binary used by the SessionEnd review.
# Auto-detected via $PATH if unset.
# export CLAUDE_BIN="$HOME/.local/bin/claude"

# Auto-commit vault changes after each SessionEnd review (only effective if vault is a git repo).
# Default: true
# export OBSIDIAN_MEMORY_AUTOCOMMIT="true"

# Auto-push vault commits to the remote after auto-commit.
# Default: false (manual push by default to give you a chance to review)
# export OBSIDIAN_MEMORY_AUTOPUSH="false"

# Retrieval gate (UserPromptSubmit hook): on every user message, ask the user's
# default Claude model whether any vault notes should be read, and inject their
# bodies into context if so. Loud non-blocking on errors.
# Default: true
# export OBSIDIAN_MEMORY_GATE_ENABLED="true"

# Maximum number of vault note paths the gate is allowed to recommend per turn.
# Default: 3
# export OBSIDIAN_MEMORY_GATE_PATH_CAP="3"

# Where the retrieval gate writes its log.
# Default: /tmp/claude-memory-gate.log
# export MEMORY_GATE_LOG="/tmp/claude-memory-gate.log"
