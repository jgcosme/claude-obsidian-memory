# obsidian-memory plugin configuration
# Copy to ~/.config/obsidian-memory/config.env and edit.
# All variables are optional; sensible defaults are used if unset.

# Path to your Obsidian vault (absolute path).
# Default: $HOME/Documents/Obsidian Memory
# export OBSIDIAN_VAULT_PATH="$HOME/Documents/Obsidian Memory"

# Path to the Obsidian CLI binary.
# Auto-detected if unset:
#   macOS: /Applications/Obsidian.app/Contents/MacOS/obsidian
#   Linux: whatever's on $PATH as `obsidian`
# export OBSIDIAN_CLI="/Applications/Obsidian.app/Contents/MacOS/obsidian"

# Where the SessionEnd review writes its log.
# Default: /tmp/claude-memory-review.log
# export MEMORY_REVIEW_LOG="/tmp/claude-memory-review.log"

# Path to the `claude` CLI binary used by the SessionEnd review.
# Auto-detected via $PATH if unset.
# export CLAUDE_BIN="$HOME/.local/bin/claude"

# Auto-commit vault changes after each SessionEnd review (only effective if vault is a git repo).
# Default: true
# export OBSIDIAN_MEMORY_AUTOCOMMIT="true"

# Auto-push vault commits to the remote after auto-commit.
# Default: false (manual push by default to give you a chance to review)
# export OBSIDIAN_MEMORY_AUTOPUSH="false"

# SessionEnd review: at session end, run a `claude -p` over the full transcript
# to write the journal entry, catch save-worthy moments the in-session
# save-memory skill missed, and run the integrity check. Set false to skip
# this entirely — auto-commit of any vault writes from the session still runs.
# The biggest single token-cost lever the plugin offers (one full-transcript
# review per session).
# Default: true
# export OBSIDIAN_MEMORY_REVIEW_ENABLED="true"

# Inject the auto-generated vault overview into the main session's context at
# SessionStart. Set false to drop it — the retrieval gate keeps its own copy
# (still reads via _overview.sh), so retrieval keeps working. The main session
# loses its in-context "scan for relevance" map, but routing/save rules live
# in the save-memory skill body and aren't affected. Saves ~5–15KB cache_read
# per turn.
# Default: true
# export OBSIDIAN_MEMORY_BOOTSTRAP_OVERVIEW="true"

# Strip tool_use / tool_result blocks from the transcript before the SessionEnd
# reviewer reads it (only user messages + assistant text + a one-line tool-use
# summary per turn are kept). Reduces transcript size ~95% on real sessions —
# tool bodies (file reads, command output, search results) dominate transcript
# size and aren't signal for save-worthy detection. Set false to pass the raw
# transcript instead.
# Default: true
# export OBSIDIAN_MEMORY_SLIM_TRANSCRIPT="true"

# Retrieval gate (UserPromptSubmit hook): on every user message, ask the user's
# default Claude model whether any vault notes should be read, and inject their
# bodies into context if so. Loud non-blocking on errors.
# Default: true
# export OBSIDIAN_MEMORY_GATE_ENABLED="true"

# Maximum number of vault note paths the gate is allowed to recommend per turn.
# Default: 3
# export OBSIDIAN_MEMORY_GATE_PATH_CAP="3"

# Where the retrieval gate writes its log.
# Default: /tmp/claude-memory-gate.log
# export MEMORY_GATE_LOG="/tmp/claude-memory-gate.log"

# Per-note byte cap for gate injection. If a vault note is larger than this,
# only the first N bytes are injected, with a [...truncated] marker. Prevents
# any single huge note from blowing the conversation context budget.
# Default: 10240 (10 KB)
# export OBSIDIAN_MEMORY_GATE_NOTE_BYTE_CAP="10240"

# Maximum size of memory hook log files. When a log grows past this, it's
# rotated to .log.1 and a fresh log is started. Applies to both review and
# gate logs.
# Default: 1048576 (1 MB)
# export MEMORY_LOG_MAX_BYTES="1048576"

# Where the gate stores per-session dedup state (one file per session_id;
# tracks which paths have already been injected so the gate doesn't repeat
# itself across consecutive turns).
# Default: /tmp/claude-memory-gate-state
# export MEMORY_GATE_DEDUP_DIR="/tmp/claude-memory-gate-state"

# Where the shared vault-overview cache lives. SessionStart and
# UserPromptSubmit both go through hooks/scripts/_overview.sh, which writes
# overviews keyed by sha1(vault|project) and invalidates them via mtime
# checks against vault *.md files.
# Default: /tmp/claude-memory-overview-cache
# export MEMORY_OVERVIEW_CACHE_DIR="/tmp/claude-memory-overview-cache"

# Show the obsidian-memory token-usage status line. When false, statusline.py
# exits silently and Claude Code shows nothing for that segment — useful when
# you have your own status line and don't want the plugin's at all.
# When false at setup.sh time, the script also skips patching the
# `statusLine` block in ~/.claude/settings.json so a fresh install doesn't
# add it. The stable symlink at ~/.config/obsidian-memory/statusline.py is
# always maintained, so flipping the flag later is purely a config edit.
# Default: true
# export OBSIDIAN_MEMORY_STATUSLINE_ENABLED="true"

# Verbose debug logging in both hooks (writes extra DEBUG lines to the logs).
# Default: false
# export OBSIDIAN_MEMORY_DEBUG="false"
